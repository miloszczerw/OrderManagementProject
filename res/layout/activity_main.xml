<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/btnOpenStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Zobacz Statystyki"
        android:visibility="gone"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnFetchOrders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pobierz zamówienia z Azure" />

    <Button
        android:id="@+id/btnOpenAddOrder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dodaj nowe zamówienie"
        android:layout_marginTop="12dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOrders"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:scrollbars="vertical" />

    </ScrollView>

    <Button
        android:id="@+id/btnOpenProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Mój Profil / Wyloguj" />
</LinearLayout>